# ─────────────────────────────────────────────
#  RescueRoute – Environment Configuration
# ─────────────────────────────────────────────

# Neon PostgreSQL (PostGIS-enabled) – pooled connection string
NEON_DATABASE_URL=postgresql+asyncpg://neondb_owner:<PASSWORD>@ep-blue-cherry-aofelcss-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Mappls (MapmyIndia) API credentials
MAPPLS_API_KEY=your_mappls_api_key_here
MAPPLS_SECRET=your_mappls_secret_here

# Backend runtime
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# AI Engine thresholds
VISION_CONFIDENCE_THRESHOLD=0.80
ACOUSTIC_CONFIDENCE_THRESHOLD=0.85

# Green-Wave timing (seconds before junction to trigger)
GREEN_WAVE_LEAD_SECONDS=30

# Signal search radius (meters)
SIGNAL_SEARCH_RADIUS_METERS=500

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
